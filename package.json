{
  "name": "a4p-image",
  "version": "0.2.0",
  "description": "붙여넣은 이미지를 Cloudflare R2에 자동 업로드하고 공개 URL로 삽입하는 옵시디언 플러그인",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "image",
    "upload",
    "plugin"
  ],
  "author": "abadcsh",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.20.2",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.4.5",
    "vitest": "^1.6.0"
  }
}
